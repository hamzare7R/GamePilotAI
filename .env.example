# Base URL of the GamePilot AI API. Keep "/api" while the backend lives in Next.js.
NEXT_PUBLIC_API_URL=/api

# Public site URL used for metadata and canonical links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only key for the RAWG games database (https://rawg.io/apidocs).
# Never expose it with a NEXT_PUBLIC_ prefix. Leave empty to run on the bundled demo catalog.
RAWG_API_KEY=

# Optional server-only override for the RAWG API origin (e.g. an outbound proxy).
# Leave empty to use https://api.rawg.io/api.
RAWG_API_BASE_URL=

# --- Owner area + custom games -------------------------------------------------
# Full Postgres connection string used to persist owner-authored games, e.g.
# postgresql://user:password@host:5432/database?sslmode=require
# Required in production (Vercel Postgres / Neon / Supabase pooled URL).
# Use the exact value from your database provider: not a placeholder such as
# "base", and not the name of another variable.
# The app also accepts POSTGRES_URL, POSTGRES_PRISMA_URL and
# POSTGRES_URL_NON_POOLING (the names Vercel Postgres/Neon provision).
# Without a valid value, local development falls back to .data/custom-games.json.
DATABASE_URL=

# Owner password. Prefer the scrypt hash produced by `npm run admin:hash`.
ADMIN_PASSWORD_HASH=
# Plaintext fallback for local development only.
ADMIN_PASSWORD=

# Signs the HttpOnly admin session cookie. Use a long random value, e.g.
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_SESSION_SECRET=

# Optional path for the development-only JSON store (never used when VERCEL is set).
CUSTOM_GAMES_FILE=

# --- Gmail integration (Mail Monitor) -----------------------------------------
# Google OAuth 2.0 client (Web application). Only the metadata-only Gmail scope
# is requested: https://www.googleapis.com/auth/gmail.metadata
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match the authorized redirect URI in Google Cloud Console exactly.
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/gmail/callback

# Pub/Sub topic that Gmail publishes to, e.g.
# projects/my-project/topics/gmail-gamepilot
GOOGLE_PUBSUB_TOPIC=
# Subscription name (short name or full path) that pushes to the webhook below.
GOOGLE_PUBSUB_SUBSCRIPTION=
# Service account allowed to push. Its OIDC token email must match this value.
GOOGLE_PUBSUB_SERVICE_ACCOUNT_EMAIL=
# Audience of the published push OIDC token: the webhook URL itself.
GOOGLE_PUBSUB_AUDIENCE=https://your-domain.example/api/webhooks/google-pubsub

# 32 random bytes, base64 encoded. Encrypts Gmail refresh tokens (AES-256-GCM).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
GMAIL_TOKEN_ENCRYPTION_KEY=

# Bearer secret for /api/cron/gmail-watch-renewal (Vercel Cron sends it).
CRON_SECRET=
